package com.cobplayer.app.ui

import android.Manifest
import android.content.Intent
import android.content.pm.PackageManager
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.provider.MediaStore
import android.view.View
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AppCompatActivity
import androidx.core.content.ContextCompat
import androidx.core.view.GravityCompat
import androidx.drawerlayout.widget.DrawerLayout
import androidx.media3.common.util.UnstableApi
import androidx.recyclerview.widget.LinearLayoutManager
import com.cobplayer.app.R
import com.cobplayer.app.data.PlaylistStore
import com.cobplayer.app.data.RecentStore
import com.cobplayer.app.databinding.ActivityMainBinding
import com.google.android.material.dialog.MaterialAlertDialogBuilder
import com.google.android.material.textfield.TextInputEditText
import androidx.appcompat.widget.AppCompatEditText

@UnstableApi
class MainActivity : AppCompatActivity() {

    private lateinit var binding: ActivityMainBinding
    private lateinit var adapter: MediaAdapter
    private var currentView: String = VIEW_VIDEOS

    private val pickFileLauncher = registerForActivityResult(
        ActivityResultContracts.OpenDocument()
    ) { uri -> uri?.let { openPlayer(it, it.lastPathSegment ?: "Selected file") } }

    private val permissionLauncher = registerForActivityResult(
        ActivityResultContracts.RequestMultiplePermissions()
    ) { loadMedia() }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        binding = ActivityMainBinding.inflate(layoutInflater)
        setContentView(binding.root)

        adapter = MediaAdapter(
            onClick = { openPlayer(Uri.parse(it.uri), it.title) },
            onLongClick = { showItemActions(it) }
        )
        binding.mediaList.layoutManager = LinearLayoutManager(this)
        binding.mediaList.adapter = adapter

        binding.menuButton.setOnClickListener {
            binding.drawerLayout.openDrawer(GravityCompat.START)
        }
        binding.navView.setNavigationItemSelectedListener { item ->
            when (item.itemId) {
                R.id.nav_videos    -> { currentView = VIEW_VIDEOS;    binding.screenTitle.text = getString(R.string.tab_videos) }
                R.id.nav_audio     -> { currentView = VIEW_AUDIO;     binding.screenTitle.text = getString(R.string.tab_audio) }
                R.id.nav_folders   -> { currentView = VIEW_FOLDERS;   binding.screenTitle.text = getString(R.string.nav_folders) }
                R.id.nav_playlists -> { currentView = VIEW_PLAYLISTS; binding.screenTitle.text = getString(R.string.nav_playlists) }
                R.id.nav_recent    -> { currentView = VIEW_RECENT;    binding.screenTitle.text = getString(R.string.nav_recent) }
                R.id.nav_open_file -> {
                    pickFileLauncher.launch(arrayOf("video/*", "audio/*"))
                    binding.drawerLayout.closeDrawers()
                    return@setNavigationItemSelectedListener true
                }
                R.id.nav_corn_store -> {
                    startActivity(Intent(Intent.ACTION_VIEW,
                        Uri.parse("https://simoesctt.github.io/corn-store-index/#/")))
                    binding.drawerLayout.closeDrawers()
                    return@setNavigationItemSelectedListener true
                }
            }
            binding.drawerLayout.closeDrawers()
            loadMedia()
            true
        }

        binding.fabOpen.setOnClickListener {
            pickFileLauncher.launch(arrayOf("video/*", "audio/*"))
        }

        requestMediaPermissions()
        binding.navView.setCheckedItem(R.id.nav_videos)
    }

    override fun onResume() { super.onResume(); loadMedia() }

    private fun requestMediaPermissions() {
        val perms = mutableListOf<String>()
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
            perms += Manifest.permission.READ_MEDIA_VIDEO
            perms += Manifest.permission.READ_MEDIA_AUDIO
        } else {
            perms += Manifest.permission.READ_EXTERNAL_STORAGE
        }
        val missing = perms.filter {
            ContextCompat.checkSelfPermission(this, it) != PackageManager.PERMISSION_GRANTED
        }
        if (missing.isEmpty()) loadMedia()
        else permissionLauncher.launch(missing.toTypedArray())
    }

    private fun loadMedia() {
        val items: List<MediaEntry> = when (currentView) {
            VIEW_VIDEOS -> queryVideos()
            VIEW_AUDIO -> queryAudio()
            VIEW_FOLDERS -> queryVideos() + queryAudio()
            VIEW_PLAYLISTS -> PlaylistStore.load(this).map {
                MediaEntry(
                    uri = "playlist:${it.id}",
                    title = "${it.name} (${it.uris.size})",
                    durationMs = 0L,
                    sizeBytes = 0L,
                    isAudio = false,
                    isPlaylist = true
                )
            }
            VIEW_RECENT -> RecentStore.load(this).map {
                MediaEntry(it.uri, it.title, 0L, 0L, false)
            }
            else -> emptyList()
        }
        adapter.submit(items)
        binding.emptyState.visibility = if (items.isEmpty()) View.VISIBLE else View.GONE
        binding.emptyState.text = when (currentView) {
            VIEW_PLAYLISTS -> getString(R.string.playlist_empty)
            else -> getString(R.string.library_empty)
        }
    }

    private fun queryVideos(): List<MediaEntry> {
        val items = mutableListOf<MediaEntry>()
        val projection = arrayOf(
            MediaStore.Video.Media._ID,
            MediaStore.Video.Media.DISPLAY_NAME,
            MediaStore.Video.Media.DURATION,
            MediaStore.Video.Media.SIZE
        )
        val sort = "${MediaStore.Video.Media.DATE_ADDED} DESC"
        contentResolver.query(
            MediaStore.Video.Media.EXTERNAL_CONTENT_URI, projection, null, null, sort
        )?.use { c ->
            val idCol = c.getColumnIndexOrThrow(MediaStore.Video.Media._ID)
            val nameCol = c.getColumnIndexOrThrow(MediaStore.Video.Media.DISPLAY_NAME)
            val durCol = c.getColumnIndexOrThrow(MediaStore.Video.Media.DURATION)
            val sizeCol = c.getColumnIndexOrThrow(MediaStore.Video.Media.SIZE)
            while (c.moveToNext()) {
                val id = c.getLong(idCol)
                items += MediaEntry(
                    uri = Uri.withAppendedPath(MediaStore.Video.Media.EXTERNAL_CONTENT_URI, id.toString()).toString(),
                    title = c.getString(nameCol) ?: "Unknown",
                    durationMs = c.getLong(durCol),
                    sizeBytes = c.getLong(sizeCol),
                    isAudio = false
                )
            }
        }
        return items
    }

    private fun queryAudio(): List<MediaEntry> {
        val items = mutableListOf<MediaEntry>()
        val projection = arrayOf(
            MediaStore.Audio.Media._ID,
            MediaStore.Audio.Media.DISPLAY_NAME,
            MediaStore.Audio.Media.DURATION,
            MediaStore.Audio.Media.SIZE,
            MediaStore.Audio.Media.ARTIST
        )
        val sort = "${MediaStore.Audio.Media.DATE_ADDED} DESC"
        contentResolver.query(
            MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, projection, null, null, sort
        )?.use { c ->
            val idCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media._ID)
            val nameCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DISPLAY_NAME)
            val durCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DURATION)
            val sizeCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.SIZE)
            val artistCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ARTIST)
            while (c.moveToNext()) {
                val id = c.getLong(idCol)
                val name = c.getString(nameCol) ?: "Unknown"
                val artist = c.getString(artistCol)
                items += MediaEntry(
                    uri = Uri.withAppendedPath(MediaStore.Audio.Media.EXTERNAL_CONTENT_URI, id.toString()).toString(),
                    title = if (artist.isNullOrBlank() || artist == "<unknown>") name else "$name — $artist",
                    durationMs = c.getLong(durCol),
                    sizeBytes = c.getLong(sizeCol),
                    isAudio = true
                )
            }
        }
        return items
    }

    private fun openPlayer(uri: Uri, title: String) {
        if (currentView == VIEW_PLAYLISTS && uri.toString().startsWith("playlist:")) {
            playPlaylist(uri.toString().removePrefix("playlist:"))
            return
        }
        RecentStore.push(this, uri, title)
        startActivity(Intent(this, PlayerActivity::class.java)
            .setData(uri)
            .putExtra("title", title))
    }

    private fun playPlaylist(id: String) {
        val pl = PlaylistStore.load(this).find { it.id == id } ?: return
        if (pl.uris.isEmpty()) return
        val intent = Intent(this, PlayerActivity::class.java)
            .setData(Uri.parse(pl.uris[0]))
            .putExtra("title", pl.titles.getOrNull(0) ?: pl.name)
            .putStringArrayListExtra("queue_uris", ArrayList(pl.uris))
            .putStringArrayListExtra("queue_titles", ArrayList(pl.titles))
        startActivity(intent)
    }

    private fun showItemActions(entry: MediaEntry) {
        val options = arrayOf(
            getString(R.string.playlist_add),
            getString(R.string.share)
        )
        MaterialAlertDialogBuilder(this)
            .setTitle(entry.title)
            .setItems(options) { _, which ->
                when (which) {
                    0 -> showAddToPlaylistDialog(entry)
                    1 -> shareItem(entry)
                }
            }
            .show()
    }

    private fun shareItem(entry: MediaEntry) {
        val intent = Intent(Intent.ACTION_SEND).apply {
            type = if (entry.isAudio) "audio/*" else "video/*"
            putExtra(Intent.EXTRA_STREAM, Uri.parse(entry.uri))
            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
        }
        startActivity(Intent.createChooser(intent, getString(R.string.share)))
    }

    private fun showAddToPlaylistDialog(entry: MediaEntry) {
        val playlists = PlaylistStore.load(this)
        val names = playlists.map { "${it.name} (${it.uris.size})" }
            .toMutableList()
            .apply { add(0, "+ ${getString(R.string.playlist_create)}") }

        MaterialAlertDialogBuilder(this)
            .setTitle(R.string.playlist_add)
            .setItems(names.toTypedArray()) { _, which ->
                if (which == 0) showCreatePlaylistDialog(entry)
                else {
                    PlaylistStore.addItem(this, playlists[which - 1].id,
                        Uri.parse(entry.uri), entry.title)
                }
            }
            .show()
    }

    private fun showCreatePlaylistDialog(entry: MediaEntry?) {
        val input = AppCompatEditText(this).apply {
            hint = getString(R.string.playlist_name_hint)
        }
        MaterialAlertDialogBuilder(this)
            .setTitle(R.string.playlist_create)
            .setView(input)
            .setPositiveButton(R.string.create) { _, _ ->
                val name = input.text?.toString()?.trim().orEmpty()
                if (name.isNotEmpty()) {
                    val pl = PlaylistStore.create(this, name)
                    entry?.let {
                        PlaylistStore.addItem(this, pl.id, Uri.parse(it.uri), it.title)
                    }
                    if (currentView == VIEW_PLAYLISTS) loadMedia()
                }
            }
            .setNegativeButton(R.string.cancel, null)
            .show()
    }

    companion object {
        private const val VIEW_VIDEOS = "videos"
        private const val VIEW_AUDIO = "audio"
        private const val VIEW_FOLDERS = "folders"
        private const val VIEW_PLAYLISTS = "playlists"
        private const val VIEW_RECENT = "recent"
    }
}

data class MediaEntry(
    val uri: String,
    val title: String,
    val durationMs: Long,
    val sizeBytes: Long,
    val isAudio: Boolean,
    val isPlaylist: Boolean = false
)
