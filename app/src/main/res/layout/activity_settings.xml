<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cob_dark_soil">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_cob_seek_back"
                android:contentDescription="@string/back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/settings"
                android:textColor="@color/cob_golden_yellow"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/CobSettingsHeader" android:text="@string/section_library" />

        <LinearLayout style="@style/CobSettingsRow">
            <LinearLayout style="@style/CobSettingsRowText">
                <TextView style="@style/CobSettingsTitle" android:text="@string/show_thumbnails" />
                <TextView style="@style/CobSettingsSubtitle" android:text="@string/show_thumbnails_desc" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_thumbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/CobSettingsRow">
            <LinearLayout style="@style/CobSettingsRowText">
                <TextView style="@style/CobSettingsTitle" android:text="@string/show_hidden" />
                <TextView style="@style/CobSettingsSubtitle" android:text="@string/show_hidden_desc" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_hidden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/CobSettingsRow">
            <LinearLayout style="@style/CobSettingsRowText">
                <TextView style="@style/CobSettingsTitle" android:text="@string/group_by_folder" />
                <TextView style="@style/CobSettingsSubtitle" android:text="@string/group_by_folder_desc" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_sort"
            style="@style/CobSettingsRow">
            <LinearLayout style="@style/CobSettingsRowText">
                <TextView style="@style/CobSettingsTitle" android:text="@string/sort_by" />
                <TextView
                    android:id="@+id/row_sort_subtitle"
                    style="@style/CobSettingsSubtitle"
                    android:text="Newest first" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/CobSettingsHeader" android:text="@string/section_playback" />

        <LinearLayout
            android:id="@+id/row_seek"
            style="@style/CobSettingsRow">
            <LinearLayout style="@style/CobSettingsRowText">
                <TextView style="@style/CobSettingsTitle" android:text="@string/seek_duration" />
                <TextView
                    android:id="@+id/row_seek_subtitle"
                    style="@style/CobSettingsSubtitle"
                    android:text="10s" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_sleep"
            style="@style/CobSettingsRow">
            <LinearLayout style="@style/CobSettingsRowText">
                <TextView style="@style/CobSettingsTitle" android:text="@string/sleep_timer_default" />
                <TextView
                    android:id="@+id/row_sleep_subtitle"
                    style="@style/CobSettingsSubtitle"
                    android:text="30 min" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
