<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="top"
        android:background="@color/cob_scrim_top" />

    <!-- Bottom scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="bottom"
        android:background="@color/cob_scrim_bottom" />

    <!-- ═══ TOP ROW: utilities ═══ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <androidx.mediarouter.app.MediaRouteButton
            android:id="@+id/cast_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btn_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_cob_share" />

        <ImageButton
            android:id="@id/exo_subtitle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/subtitles"
            android:src="@drawable/ic_cob_subtitles" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_cob_settings" />

        <ImageButton
            android:id="@id/exo_fullscreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fullscreen"
            android:src="@drawable/ic_cob_fullscreen" />
    </LinearLayout>

    <!-- ═══ CENTER: play/pause ═══ -->
    <ImageButton
        android:id="@id/exo_play_pause"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/play"
        android:src="@drawable/ic_cob_pause" />

    <ProgressBar
        android:id="@id/exo_buffering"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/cob_amber"
        android:visibility="gone" />

    <!-- ═══ BOTTOM: scrubber + transport ═══ -->
    <LinearLayout
        android:id="@+id/cob_controls_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="64dp">

        <!-- Scrubber row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@id/exo_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:textColor="@color/cob_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                app:played_color="@color/cob_amber"
                app:buffered_color="@color/cob_toasted"
                app:unplayed_color="@color/cob_husk_light"
                app:scrubber_color="@color/cob_deep_orange" />

            <TextView
                android:id="@id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:gravity="end"
                android:textColor="@color/cob_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Transport row — only 4 buttons, fits easily -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <ImageButton
                android:id="@id/exo_prev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Previous"
                android:src="@drawable/ic_cob_seek_back" />

            <ImageButton
                android:id="@id/exo_rew"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/rewind"
                android:src="@drawable/ic_cob_seek_back" />

            <ImageButton
                android:id="@id/exo_ffwd"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fast_forward"
                android:src="@drawable/ic_cob_seek_forward" />

            <ImageButton
                android:id="@id/exo_next"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Next"
                android:src="@drawable/ic_cob_seek_forward" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
