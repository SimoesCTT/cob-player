    <style name="CobSettingsHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/cob_amber</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="CobSettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
    <style name="CobSettingsRowText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="CobSettingsSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cob_text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="CobSettingsTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cob_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Theme.CobPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cob_amber</item>
        <item name="colorOnPrimary">@color/cob_dark_soil</item>
        <item name="colorPrimaryContainer">@color/cob_husk_bg</item>
        <item name="colorSecondary">@color/cob_golden_yellow</item>
        <item name="colorOnSecondary">@color/cob_dark_soil</item>
        <item name="android:colorBackground">@color/cob_dark_soil</item>
        <item name="colorSurface">@color/cob_husk_bg</item>
        <item name="colorOnSurface">@color/cob_text_primary</item>
        <item name="colorSurfaceVariant">@color/cob_husk_light</item>
        <item name="android:statusBarColor">@color/cob_dark_soil</item>
        <item name="android:navigationBarColor">@color/cob_dark_soil</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
