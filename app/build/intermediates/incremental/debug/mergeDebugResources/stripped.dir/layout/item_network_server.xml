<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingHorizontal="20dp" android:paddingVertical="14dp">

    <TextView android:id="@+id/label"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/cob_text_primary"
        android:textSize="15sp" android:textStyle="bold" />

    <TextView android:id="@+id/sub"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/cob_text_muted"
        android:textSize="12sp" />
</LinearLayout>
