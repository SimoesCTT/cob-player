<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/proto_spinner"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/in_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/field_label" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/in_host"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/field_host"
            android:inputType="textUri" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/in_port"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/field_port"
            android:inputType="number" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/in_user"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/field_user" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/in_pass"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/field_pass"
            android:inputType="textPassword" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/in_path"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/field_path" />
    </LinearLayout>
</ScrollView>
