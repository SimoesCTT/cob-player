<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cob_dark_soil">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_subtitle_button="true"
        app:show_buffering="when_playing"
        app:shutter_background_color="@color/cob_dark_soil"
        app:controller_layout_id="@layout/cob_player_controls"
        android:fitsSystemWindows="true"
        android:keepScreenOn="true" />

    <com.cobplayer.app.ui.KernelSpectrumView
        android:id="@+id/spectrum"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="180dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/seek_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        android:background="#CC2D1B0E"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:textColor="@color/cob_golden_yellow"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/gesture_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC2D1B0E"
        android:paddingHorizontal="24dp"
        android:paddingVertical="14dp"
        android:textColor="@color/cob_amber"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
